# Postgres connection string
DATABASE_URL="postgresql://usuario:senha@localhost:5432/selfcheckapp"

# Stripe (use test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
# Printed by `stripe listen` locally, or shown in the webhook settings in production
STRIPE_WEBHOOK_SECRET_KEY="whsec_..."

# Signs the admin panel session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="..."

# Show the demo login (demo@tigela.com / tigela123) on the admin login page
SHOW_DEMO_LOGIN="true"
