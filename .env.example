# Postgres connection string
DATABASE_URL="postgresql://usuario:senha@localhost:5432/selfcheckapp"

# Stripe (use test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
# Printed by `stripe listen` locally, or shown in the webhook settings in production
STRIPE_WEBHOOK_SECRET_KEY="whsec_..."

# Signs the admin panel session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="..."

# Demo mode: one-click admin login, test-card hints and a daily data reset.
# Use "true" for the public portfolio demo, never for a real shop.
DEMO_MODE="true"

# Protects the daily demo reset (Vercel Cron). Only needed in production with
# DEMO_MODE on. Generate one the same way as AUTH_SECRET.
CRON_SECRET=""
